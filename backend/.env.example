# =============================================
# LogSentinel - Variables de Entorno (PLANTILLA)
# =============================================
# Copia este archivo como .env y completa los valores.
# NUNCA subas el archivo .env al repositorio.

# --- IA: Ollama (perfil por defecto, local, sin API key) ---
# Solo necesario si el servicio Ollama no corre en el host/puerto por defecto.
# En docker-compose ya se inyecta automáticamente como http://ollama:11434
#SPRING_AI_OLLAMA_BASE_URL=http://localhost:11434

# --- IA: OpenAI (perfil opcional, solo si SPRING_PROFILES_ACTIVE incluye "openai") ---
#SPRING_AI_OPENAI_API_KEY=tu_api_key_aqui

# --- PostgreSQL ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/logsentinel
SPRING_DATASOURCE_USERNAME=logsentinel
SPRING_DATASOURCE_PASSWORD=logsentinel
